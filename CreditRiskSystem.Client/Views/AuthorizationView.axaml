<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreditRiskSystem.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CreditRiskSystem.Client.Views.AuthorizationView"
             x:DataType="vm:AuthorizationViewModel">
	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50" CornerRadius="10" BoxShadow="0 0 10 0 DarkGray">
		<StackPanel Margin="20" Spacing="25">
			<TextBlock Text="Авторизация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
			<TextBox Text="{Binding Username}" CornerRadius="10" Watermark="Логин" HorizontalAlignment="Stretch"/>
			<TextBox Text="{Binding Password}" CornerRadius="10" Watermark="Пароль" PasswordChar="•" HorizontalAlignment="Stretch"/>
			<Grid ColumnDefinitions="Auto *" Margin="5">
				<Button Grid.Column="0" Margin="5" Content="Войти" CornerRadius="5" Background="Chartreuse" Foreground="Black" Padding="25 10" Command="{Binding LoginCommand}"/>
				<Button Grid.Column="1" Margin="5" Content="Зарегистрироваться" CornerRadius="5" Background="#D9D9D9" Foreground="Black" Padding="25 10" Command="{Binding RegisterCommand}"/>
			</Grid>
			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"/>
		</StackPanel>
	</Border>
</UserControl>
