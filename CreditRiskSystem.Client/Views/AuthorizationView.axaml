<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreditRiskSystem.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CreditRiskSystem.Client.Views.AuthorizationView"
             x:DataType="vm:AuthorizationViewModel">
	<StackPanel Margin="20" Spacing="10">
		<TextBlock Text="Авторизация" FontSize="20" HorizontalAlignment="Center"/>
		<TextBox Text="{Binding Username}" Watermark="Логин"/>
		<TextBox Text="{Binding Password}" Watermark="Пароль" PasswordChar="*"/>
		<Button Content="Войти" Command="{Binding LoginCommand}"/>
		<Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}"/>
		<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"/>
	</StackPanel>
</UserControl>
