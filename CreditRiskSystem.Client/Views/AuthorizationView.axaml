<UserControl xmlns="https://github.com/avaloniaui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreditRiskSystem.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CreditRiskSystem.Client.Views.AuthorizationView"
             x:DataType="vm:AuthorizationViewModel">

    <UserControl.Styles>
        <!-- Базовые стили для StackPanel -->
        <Style Selector="StackPanel">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Padding" Value="40"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" Color="#33FF33"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок -->
        <Style Selector="TextBlock#Title">
            <Setter Property="Foreground" Value="#CCFF00"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 20 0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#33FF33"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="WatermarkForeground" Value="#888"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Margin" Value="0 0 10 0"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#33FF33"/>
            <Setter Property="Foreground" Value="#000"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8 6"/>
            <Setter Property="Margin" Value="0 0 10 0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#33FF33"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ховер на кнопках -->
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#66FF66"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#66FF66"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Сообщение об ошибке -->
        <Style Selector="TextBlock#ErrorMessage">
            <Setter Property="Foreground" Value="#FF4D4D"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 10 0 0"/>
        </Style>
    </UserControl.Styles>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel MinWidth="300" Spacing="15">
            <TextBlock Name="Title" Text="Авторизация" />
            <TextBox Text="{Binding Username}" Watermark="Логин"/>
            <TextBox Text="{Binding Password}" Watermark="Пароль" PasswordChar="*"/>
            <Button Content="Войти" Command="{Binding LoginCommand}"/>
            <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}"/>
            <TextBlock Name="ErrorMessage" Text="{Binding ErrorMessage}" />
        </StackPanel>
    </Grid>
</UserControl>