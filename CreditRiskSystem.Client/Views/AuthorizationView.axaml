<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreditRiskSystem.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="CreditRiskSystem.Client.Views.AuthorizationView"
             x:DataType="vm:AuthorizationViewModel">
	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50" CornerRadius="10" BoxShadow="0 0 10 0 DarkGray">
		<StackPanel Margin="20" Spacing="25">
			<StackPanel Spacing="10">
				<TextBlock Text="Авторизация"
				           FontSize="32"
				           FontWeight="Bold"
				           HorizontalAlignment="Center"/>
				<TextBlock Text="Войдите в свой аккаунт, чтобы получить доступ к персонализированным функциям и возможностям."
				           TextWrapping="Wrap" TextAlignment="Center"
				           Width="350"
				           FontSize="16"
				           HorizontalAlignment="Center"/>
			</StackPanel>
			<TextBox Text="{Binding Username}"
			         BorderBrush="#D9D9D9"
			         CornerRadius="5"
			         Height="56"
			         VerticalContentAlignment="Center"
			         Padding="15 0"
			         Watermark="Логин"
			         HorizontalAlignment="Stretch">
				<TextBox.InnerLeftContent>
					<Svg Path="/Assets/user.svg" Height="16"/>
				</TextBox.InnerLeftContent>
			</TextBox>
			<TextBox Text="{Binding Password}"
			         BorderBrush="#D9D9D9"
			         CornerRadius="5"
			         Height="56"
			         VerticalContentAlignment="Center"
			         Padding="15 0"
			         Watermark="Пароль"
			         PasswordChar="•"
			         HorizontalAlignment="Stretch">
				<TextBox.InnerLeftContent>
					<Svg Path="/Assets/lock.svg" Height="16"/>
				</TextBox.InnerLeftContent>
			</TextBox>
			<Grid ColumnDefinitions="Auto *" Margin="-5">
				<Button Content="Авторизоваться"
				        Grid.Column="0"
				        Height="56"
				        VerticalContentAlignment="Center"
				        Margin="5"
				        CornerRadius="5"
				        Background="Chartreuse"
				        Foreground="Black"
				        Padding="25 10"
				        Command="{Binding LoginCommand}"/>
				<Button Content="Зарегистрироваться"
				        Grid.Column="1"
				        Height="56"
				        VerticalContentAlignment="Center"
				        Margin="5"
				        CornerRadius="5"
				        Background="#D9D9D9"
				        Foreground="Black"
				        Padding="25 10"
				        Command="{Binding RegisterCommand}"/>
			</Grid>
			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"/>
		</StackPanel>
	</Border>
</UserControl>
