<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreditRiskSystem.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CreditRiskSystem.Client.Views.MainView"
             x:DataType="vm:MainViewModel">
    <StackPanel Margin="20" Spacing="10">
		<Button Content="Загрузить файл Excel" Command="{Binding UploadFileCommand}" />
        <Button Content="Скачать PDF" Command="{Binding DownloadPdfCommand}" />
        <Button Content="Скачать JSON" Command="{Binding DownloadJsonCommand}" />
		<TextBlock Text="Результаты расчета:" />
		<TextBox Text="{Binding Result}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="200" />
	</StackPanel>
</UserControl>
